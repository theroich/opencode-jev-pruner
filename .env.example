# Required: TypeSafe / OpenCode Console API key for Jev.
JEV_API_KEY=sk-...

# Optional overrides. Defaults shown.
# JEV_URL=https://opencode.ai/inference/systemone/v1/systemone
# JEV_MODEL=jev-1.13
# JEV_CONFIDENCE_THRESHOLD=0.55
# JEV_PHASE1_THRESHOLD=0.35
# JEV_TIMEOUT_MS=900
# JEV_FAILURE_COOLDOWN_MS=0
# JEV_WARMUP=false
# JEV_PRUNER_DEBUG=false
# JEV_PRUNER_DEBUG_LOG=/tmp/jev-pruner.jsonl
